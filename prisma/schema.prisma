generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageType {
  MARKET
  RETAIL
}

enum PaymentMethod {
  CASH
  CARD
  QR
  CREDIT
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  PARTIAL_REFUND
  PENDING_SYNC
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum CampaignType {
  PERCENTAGE
  FIXED
  BUY_X_GET_Y
  SEASONAL
}

enum PaperWidth {
  MM_58
  MM_80
}

enum PrinterConnection {
  USB
  ETHERNET
  WIFI
  BLUETOOTH
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

model PlatformConfig {
  id               String   @id @default("aura-platform")
  name             String   @default("Aura Barkod")
  domain           String?
  trialDays        Int      @default(14)
  maxTrialUsers    Int      @default(5)
  maxTrialProducts Int      @default(100)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Organization {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  email            String?
  phone            String?
  address          String?
  taxNumber        String?
  taxOffice        String?
  mersisNo         String?
  packageType      PackageType  @default(MARKET)
  status           TenantStatus @default(TRIAL)
  trialExpiresAt   DateTime?
  setupCompletedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  branches    Branch[]
  users       User[]
  products    Product[]
  customers   Customer[]
  campaigns   Campaign[]
  suppliers   Supplier[]
  backups     BackupLog[]
  receiptSettings ReceiptSettings?
  subscription    TenantSubscription?

  @@index([status])
}

model TenantSubscription {
  id               String           @id @default(cuid())
  organizationId   String           @unique
  plan             SubscriptionPlan @default(TRIAL)
  monthlyPrice     Decimal          @default(0) @db.Decimal(12, 2)
  status           String           @default("active")
  currentPeriodEnd DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  registers    CashRegister[]
  sales        Sale[]
  zReports     ZReport[]
  shortcuts    ProductShortcut[]

  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String?
  branchId       String?
  email          String   @unique
  passwordHash   String
  name           String
  role           String   @default("cashier")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model CashRegister {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sales  Sale[]
  zReports ZReport[]

  @@unique([branchId, code])
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  parentId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([organizationId])
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  barcode        String?
  sku            String?
  price          Decimal  @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  taxRate        Decimal  @default(20) @db.Decimal(5, 2)
  stock          Decimal  @default(0) @db.Decimal(12, 3)
  minStock       Decimal  @default(10) @db.Decimal(12, 3)
  unit           String   @default("adet")
  isWeighted     Boolean  @default(false)
  isActive       Boolean  @default(true)
  hasVariants    Boolean  @default(false)
  imageUrl       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]
  saleItems    SaleItem[]
  shortcuts    ProductShortcut[]

  @@unique([organizationId, barcode])
  @@index([organizationId])
  @@index([barcode])
  @@index([name])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  barcode   String?
  size      String?
  color     String?
  price     Decimal? @db.Decimal(12, 2)
  stock     Decimal  @default(0) @db.Decimal(12, 3)
  sku       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@unique([productId, barcode])
  @@index([barcode])
}

model ProductShortcut {
  id        String @id @default(cuid())
  branchId  String
  productId String
  keySlot   Int

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, keySlot])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  loyaltyPoints  Int      @default(0)
  birthDate      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account      CustomerAccount?
  sales        Sale[]
  loyaltyLogs  LoyaltyLog[]

  @@index([organizationId])
  @@index([phone])
}

model CustomerAccount {
  id               String    @id @default(cuid())
  customerId       String    @unique
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  creditLimit      Decimal   @default(0) @db.Decimal(12, 2)
  paymentDueDate   DateTime?
  paymentPromiseNote String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entries  CreditEntry[]

  @@index([paymentDueDate])
}

model CreditEntry {
  id        String    @id @default(cuid())
  accountId String
  saleId    String?
  amount    Decimal   @db.Decimal(12, 2)
  type      String
  note      String?
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  account CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model Campaign {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  type           CampaignType
  value          Decimal      @db.Decimal(12, 2)
  buyQuantity    Int?
  getQuantity    Int?
  minAmount      Decimal?     @db.Decimal(12, 2)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  taxNumber      String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     PurchaseInvoice[]
}

model PurchaseInvoice {
  id         String   @id @default(cuid())
  supplierId String
  invoiceNo  String
  total      Decimal  @db.Decimal(12, 2)
  items      Json
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Sale {
  id             String        @id @default(cuid())
  branchId       String
  registerId     String
  customerId     String?
  receiptNo      String
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod
  status         SaleStatus    @default(COMPLETED)
  offlineId      String?       @unique
  syncedAt       DateTime?
  digitalReceipt Boolean       @default(false)
  receiptEmail   String?
  receiptPhone   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch   Branch       @relation(fields: [branchId], references: [id])
  register CashRegister @relation(fields: [registerId], references: [id])
  customer Customer?    @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments Payment[]
  eInvoice EInvoiceRecord?

  @@index([branchId, createdAt])
  @@index([receiptNo])
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  productId  String
  variantId  String?
  name       String
  barcode    String?
  quantity   Decimal @db.Decimal(12, 3)
  unitPrice  Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  taxRate    Decimal @db.Decimal(5, 2)
  total      Decimal @db.Decimal(12, 2)
  refunded   Boolean @default(false)

  sale    Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Decimal       @db.Decimal(12, 2)
  reference String?
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model ZReport {
  id           String   @id @default(cuid())
  branchId     String
  registerId   String
  reportDate   DateTime
  totalSales   Decimal  @db.Decimal(12, 2)
  totalRefunds Decimal  @default(0) @db.Decimal(12, 2)
  cashTotal    Decimal  @default(0) @db.Decimal(12, 2)
  cardTotal    Decimal  @default(0) @db.Decimal(12, 2)
  qrTotal      Decimal  @default(0) @db.Decimal(12, 2)
  creditTotal  Decimal  @default(0) @db.Decimal(12, 2)
  saleCount    Int      @default(0)
  createdAt    DateTime @default(now())

  branch   Branch       @relation(fields: [branchId], references: [id])
  register CashRegister @relation(fields: [registerId], references: [id])

  @@unique([registerId, reportDate])
}

model EInvoiceRecord {
  id        String   @id @default(cuid())
  saleId    String   @unique
  uuid      String?
  status    String   @default("pending")
  provider  String
  response  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model LoyaltyLog {
  id         String   @id @default(cuid())
  customerId String
  points     Int
  reason     String
  saleId     String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model SyncQueue {
  id             String     @id @default(cuid())
  organizationId String?
  entityType     String
  entityId       String
  payload        Json
  status         SyncStatus @default(PENDING)
  retries        Int        @default(0)
  error          String?
  createdAt      DateTime   @default(now())
  syncedAt       DateTime?

  @@index([status, createdAt])
  @@index([organizationId])
}

model BackupLog {
  id             String   @id @default(cuid())
  organizationId String
  filePath       String
  sizeBytes      Int
  status         String   @default("completed")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model AccountingExport {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  periodStart    DateTime
  periodEnd      DateTime
  filePath       String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
}

model ReceiptSettings {
  id                 String            @id @default(cuid())
  organizationId     String            @unique
  storeName          String
  address            String?
  phone              String?
  email              String?
  website            String?
  taxNumber          String?
  taxOffice          String?
  mersisNo           String?
  footerText         String?           @default("Bizi tercih ettiğiniz için teşekkürler!")
  paperWidth         PaperWidth        @default(MM_80)
  fontScale          String            @default("normal")
  printerBrand       String?
  printerModel       String?
  printerConnection  PrinterConnection @default(USB)
  autoPrint          Boolean           @default(true)
  showTaxDetails     Boolean           @default(true)
  showCashierName    Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
